<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tfmm.App.Views.Logo"
             Width="38" Height="38">
  <!-- An F drawn as a transit line with a station at each of its three ends, drawn like
       terminus stops on a route map (a ring a bit wider than the line). Keep the top arm longer
       so it stays an F. 64-unit grid; tools/make_icon.py draws the same shapes. -->
  <Border CornerRadius="9" Background="{StaticResource Accent}">
    <Viewbox>
      <Canvas Width="64" Height="64">
        <Path Data="M24,48 V14 H44 M24,30 H37" Stroke="{StaticResource Ink}" StrokeThickness="10"
              StrokeLineCap="Round" StrokeJoin="Round" />
        <Ellipse Canvas.Left="37.5" Canvas.Top="7.5" Width="13" Height="13" Fill="{StaticResource Ink}" />
        <Ellipse Canvas.Left="41.1" Canvas.Top="11.1" Width="5.8" Height="5.8" Fill="{StaticResource Accent}" />
        <Ellipse Canvas.Left="30.5" Canvas.Top="23.5" Width="13" Height="13" Fill="{StaticResource Ink}" />
        <Ellipse Canvas.Left="34.1" Canvas.Top="27.1" Width="5.8" Height="5.8" Fill="{StaticResource Accent}" />
        <Ellipse Canvas.Left="17.5" Canvas.Top="41.5" Width="13" Height="13" Fill="{StaticResource Ink}" />
        <Ellipse Canvas.Left="21.1" Canvas.Top="45.1" Width="5.8" Height="5.8" Fill="{StaticResource Accent}" />
      </Canvas>
    </Viewbox>
  </Border>
</UserControl>
