<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tfmm.App.Views.Logo"
             Width="38" Height="38">
  <!-- A sans-serif J drawn as a transit line: a straight stem and the hook,
       with a terminus station at each end (a ring a bit wider than the line, like on a route map).
       While the app is loading, a train runs along it (Logo.axaml.cs follows the same route).
       64-unit grid; tools/make_icon.py draws the same shapes. -->
  <Border CornerRadius="9" Background="{StaticResource Accent}">
    <Viewbox>
      <Canvas x:Name="Board" Width="64" Height="64">
        <Path Data="M45,14 V38 A13,13 0 0 1 19,38" Stroke="{StaticResource Ink}" StrokeThickness="10"
              StrokeLineCap="Round" />
        <Ellipse Canvas.Left="38.5" Canvas.Top="7.5" Width="13" Height="13" Fill="{StaticResource Ink}" />
        <Ellipse Canvas.Left="42.1" Canvas.Top="11.1" Width="5.8" Height="5.8" Fill="{StaticResource Accent}" />
        <Ellipse Canvas.Left="12.5" Canvas.Top="31.5" Width="13" Height="13" Fill="{StaticResource Ink}" />
        <Ellipse Canvas.Left="16.1" Canvas.Top="35.1" Width="5.8" Height="5.8" Fill="{StaticResource Accent}" />
      </Canvas>
    </Viewbox>
  </Border>
</UserControl>
