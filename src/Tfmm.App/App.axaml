<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tfmm.App.ViewModels"
             xmlns:v="using:Tfmm.App.Views"
             x:Class="Tfmm.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Theme/Icons.axaml" />
        <ResourceInclude Source="/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel"><v:LibraryView /></DataTemplate>
    <DataTemplate DataType="vm:PlaysetsViewModel"><v:PlaysetsView /></DataTemplate>
    <DataTemplate DataType="vm:PerformanceViewModel"><v:PerformanceView /></DataTemplate>
    <DataTemplate DataType="vm:CrashesViewModel"><v:CrashesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
