<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" /><Setter Property="LetterSpacing" Value="1.8" />
    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="40" /><Setter Property="LineHeight" Value="48" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="26" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" /><Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{StaticResource Faint2}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="26" /><Setter Property="Foreground" Value="{StaticResource Amber}" />
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="40" /><Setter Property="Foreground" Value="{StaticResource Amber}" />
  </Style>
  <Style Selector="TextBlock.body"><Setter Property="LineHeight" Value="21" /><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}" /></Style>
  <Style Selector="TextBlock.muted2"><Setter Property="Foreground" Value="{StaticResource Muted2}" /></Style>
  <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource Faint2}" /></Style>
  <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="TextBlock.name"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" /></Style>

  <!-- Surfaces -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Border.head">
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{StaticResource RowLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.tag">
    <Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{StaticResource Tag}" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag > TextBlock">
    <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="Border.mono-tile">
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#171B22" /><Setter Property="BorderBrush" Value="#252C37" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.mono-tile > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- ERR / WARN / NOTE stamps -->
  <Style Selector="Border.stamp">
    <Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="0,1" /><Setter Property="MinWidth" Value="42" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.stamp > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="FontSize" Value="10.5" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line3}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1E242D" /><Setter Property="BorderBrush" Value="{StaticResource Line4}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Card}" /></Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Card}" /><Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" /><Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FF9A52" /><Setter Property="BorderBrush" Value="#FF9A52" /><Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#E97A30" /></Style>
  <Style Selector="Button.primary TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
  <Style Selector="Button.primary PathIcon"><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Raised}" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.icon"><Setter Property="Padding" Value="0" /><Setter Property="Width" Value="40" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ErrSoft}" /><Setter Property="BorderBrush" Value="{StaticResource Err}" />
    <Setter Property="Foreground" Value="{StaticResource ErrText}" />
  </Style>
  <!-- whole-row buttons -->
  <Style Selector="Button.rowbtn">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.rowbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#11141A" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Sidebar nav -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" CornerRadius="9" Padding="12,10" Background="Transparent">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Name="ic" Data="{TemplateBinding Tag}" Width="18" Height="18" Foreground="{StaticResource Muted}" />
            <ContentPresenter Grid.Column="1" Name="txt" Margin="12,0,0,0" Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Muted}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bg"><Setter Property="Background" Value="{StaticResource Card}" /></Style>
  <Style Selector="RadioButton.nav:pointerover /template/ ContentPresenter#txt"><Setter Property="Foreground" Value="{StaticResource Text}" /></Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bg"><Setter Property="Background" Value="{StaticResource AccentSoft}" /></Style>
  <Style Selector="RadioButton.nav:checked /template/ ContentPresenter#txt">
    <Setter Property="Foreground" Value="{StaticResource AccentText}" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ PathIcon#ic"><Setter Property="Foreground" Value="{StaticResource AccentText}" /></Style>

  <!-- Filter pills -->
  <Style Selector="RadioButton.pill">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" CornerRadius="999" Height="34" Padding="14,0" Background="{StaticResource Card}"
                BorderBrush="{StaticResource Line3}" BorderThickness="1">
          <ContentPresenter Name="txt" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.pill:pointerover /template/ Border#bg"><Setter Property="BorderBrush" Value="{StaticResource Dim}" /></Style>
  <Style Selector="RadioButton.pill:checked /template/ Border#bg">
    <Setter Property="Background" Value="{StaticResource Text}" /><Setter Property="BorderBrush" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="RadioButton.pill:checked /template/ ContentPresenter#txt"><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>

  <!-- Segmented switch -->
  <Style Selector="RadioButton.seg">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" CornerRadius="8" Height="34" Padding="14,0" Background="Transparent">
          <ContentPresenter Name="txt" Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#bg"><Setter Property="Background" Value="{StaticResource Text}" /></Style>
  <Style Selector="RadioButton.seg:checked /template/ ContentPresenter#txt"><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>

  <!-- Lists: rows draw their own selection bar -->
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.rows > ListBoxItem">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" /><Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#11141A" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Hover}" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Hover}" />
  </Style>
  <Style Selector="ListBox.tickets > ListBoxItem">
    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.tickets > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Rectangle.selbar"><Setter Property="Width" Value="3" /><Setter Property="Fill" Value="{StaticResource Accent}" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="42" /><Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="TextBox.mono"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="TextBox.title">
    <Setter Property="FontFamily" Value="{StaticResource CondFont}" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="32" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBox.title:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="42" /></Style>

  <Style Selector="PathIcon"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line4}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
</Styles>
